    }

    public function me()
    {
        $memberResponse = $this->api->authGet('browse-members/me');
        $d = $memberResponse['data'] ?? [];

    public function me()
    {
        $memberResponse = $this->api->authGet('browse-members/me');
        $d = $memberResponse['data'] ?? [];

        $member = [
            'id'         => $d['id'] ?? null,
            'profile_id' => $d['profile_id'] ?? null,
            'member_no'  => $d['member_no'] ?? null,
            'restricted' => false,
            'is_own'     => true,
            'basic' => [
                'name'            => $d['name'] ?? null,
                'age'             => $d['age'] ?? null,
                'dob'             => $d['dob'] ?? null,
                'gender'          => $d['gender'] ?? null,
